# Bytecode & Python packaging
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
*.whl

# Test & linter caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local virtual / conda environments
.venv/
venv/
env/
.conda/

# Training logs & TensorBoard events
runs/
logs/
*.tfevents*
*.log

# Model checkpoints (keep ppoc_best.pt tracked for out-of-the-box evaluation/Arena UI)
checkpoints/*.pt
checkpoints/*.pth
!checkpoints/ppoc_best.pt

# Temporary simulation media & scratch outputs
*.mp4
*.avi
*.mkv
*.tmp

# IDE & OS metadata
.vscode/
.idea/
.DS_Store
Thumbs.db

